// messages/autocar_msgs/msg/TrackedObjects.idl
// One struct per file: ROS 2 rosidl treats two structs as a service.
#include "std_msgs/msg/Header.idl"
#include "autocar_msgs/msg/TrackedObject.idl"

module autocar_msgs {
  module msg {
    struct TrackedObjects {
      std_msgs::msg::Header header;
      sequence<autocar_msgs::msg::TrackedObject> objects;
    };
  };
};
